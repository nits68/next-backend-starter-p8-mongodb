# Connection string for MongoDB.
# Requires MongoDB >= 8.0.

# Standalone local mongod / `docker run mongo:8` — no replica set required for first-run queries.
# Transactions and change streams need a replica set; add ?replicaSet=... only after initiating one.

MONGODB_URL="mongodb+srv://username:password@sandbox.??????.mongodb.net/prisma8db?retryWrites=true&w=majority&authSource=admin"
DATABASE_URL="mongodb+srv://username:password@sandbox.??????.mongodb.net/prisma8db?retryWrites=true&w=majority&authSource=admin"



